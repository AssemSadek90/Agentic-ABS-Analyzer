# Required
ANTHROPIC_API_KEY=sk-ant-...
APP_ENCRYPTION_KEY=

# Optional overrides (defaults match docker-compose.yml)
DATABASE_URL=postgres://
PORT=3001

# Optional: model catalog (see README "LLM model catalog")
# Server-side keys used ONLY to list these providers' models (users still bring their own keys).
OPENAI_API_KEY=
GEMINI_API_KEY=
# Pin the default model instead of "newest low-cost Claude model".
DEFAULT_MODEL=
# Secret Vercel Cron sends to /api/cron/refresh-models (deploy only).
CRON_SECRET=
